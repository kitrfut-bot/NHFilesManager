# Copy this file to app/keystore.properties (same folder) and fill in your own values.
# app/keystore.properties is in .gitignore — it must NEVER be committed to GitHub.
#
# Generate the keystore first (from the project root), then fill in the same alias/passwords here:
#   keytool -genkeypair -v -keystore app/nhfiles-release.keystore -alias nhfiles \
#     -keyalg RSA -keysize 2048 -validity 9125 -storetype PKCS12
#
# -validity 9125 sets the certificate's expiry to 25 years from today (9125 days). Change it to
# whatever expiry date you want, e.g. -validity 3650 for 10 years. keytool will ask for the
# store password, key password and your name/org details (used as the certificate's identity).
# After it expires, Android will refuse to install updates signed with it, so pick a long value
# for anything you plan to keep publishing — Google Play requires at least 25 years (Oct 2033+).

storeFile=nhfiles-release.keystore
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=nhfiles
# PKCS12 (the format used above) requires keyPassword to equal storePassword — keytool
# will enforce this itself when you generate the keystore.
keyPassword=CHANGE_ME_STORE_PASSWORD
