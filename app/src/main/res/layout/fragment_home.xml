<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:orientation="vertical">
    <LinearLayout android:id="@+id/continueSection" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginTop="4dp"
            android:text="Continue Watching" android:textColor="@color/text_primary"
            android:textSize="15sp" android:textStyle="bold" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/continueList"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:clipToPadding="false" android:paddingHorizontal="12dp" android:paddingVertical="8dp" />
    </LinearLayout>
    <com.google.android.material.tabs.TabLayout android:id="@+id/tabs"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/bg" app:tabIndicatorColor="@color/orange"
        app:tabSelectedTextColor="@color/orange" app:tabTextColor="@color/text_secondary" />
    <androidx.viewpager2.widget.ViewPager2 android:id="@+id/pager"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
